# This repo has never carried a checked-in .env.example before the
# render-isolation work (docs/BUILD_PLAN_render_isolation_v1.md); the
# app's full env-var set (63 vars as of 2026-08-07, per
# Version3_CaseLoadSelect/CaseLoadSelect_RendererIsolation_Spec_2026-08-07.md)
# lives in Vercel project settings and local .env.local files, not here.
# This file documents ONLY the two new vars the render-isolation work
# introduces, so a deploying operator has one place to look for them.

# Base URL of the isolated render service (services/render/ in this repo,
# deployed as its own Vercel project -- "caseload-render" per the build
# plan). No trailing slash. The main app POSTs to
# {RENDER_SERVICE_URL}/api/render.
RENDER_SERVICE_URL=https://caseload-render.vercel.app

# Shared bearer token authenticating the main app to the render service.
# High-entropy, rotatable, and the ONLY credential the render service's
# environment is allowed to hold -- set as RENDER_SERVICE_TOKEN in BOTH
# the main app's Vercel project and the render service's Vercel project,
# with the identical value. See docs/RUNBOOK_render_isolation_deploy_v1.md.
RENDER_SERVICE_TOKEN=

# Secure Import Room global kill switch. Live HighLevel contact creation is
# impossible unless this is true AND the target firm's two database flags are
# enabled. Leave false until the firm token passes the documented read-only
# exact-lookup smoke test and Contact Created workflows are audited.
CLIENT_IMPORT_LIVE_WRITES_ENABLED=false

# Optional dedicated HMAC secret for one-use import authorization challenges
# and PII-free row fingerprints. When omitted, the server falls back to the
# existing PORTAL_SECRET. Never expose either value to the browser.
CLIENT_IMPORT_HMAC_SECRET=
