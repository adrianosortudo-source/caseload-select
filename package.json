{
  "name": "caseload-select",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "build": "node scripts/check-self-contained-build-assets.mjs && node scripts/check-no-em-dash-marketing.mjs && node scripts/check-cron-contract.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "check:em-dash-marketing": "node scripts/check-no-em-dash-marketing.mjs",
    "check:build-assets": "node scripts/check-self-contained-build-assets.mjs",
    "check:readable-measure": "vitest run src/lib/__tests__/readable-measure-contract.test.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:engine-sync": "bash scripts/check-engine-sync.sh",
    "check:engine-sync:win": "powershell -ExecutionPolicy Bypass -File scripts/check-engine-sync.ps1",
    "check:engine-manifest": "bash scripts/check-engine-manifest.sh",
    "gen:engine-manifest": "bash scripts/gen-engine-manifest.sh",
    "publishing:bind-heroes": "node scripts/publishing-bind-heroes.mjs",
    "publishing:export-packets": "node scripts/publishing-export-packets.mjs",
    "check:seo-calibration": "node scripts/seo-check-calibration-acceptance.mjs",
    "record:seo-calibration": "node scripts/seo-check-record-calibration-fixture.mjs",
    "drg:deploy": "tsx scripts/drg-deploy/cli.ts",
    "drg:revise-checklists": "tsx scripts/drg-deploy/checklist-revision.ts"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@google/generative-ai": "^0.24.1",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/supabase-js": "^2.45.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/functions": "^3.5.1",
    "next": "^16.2.3",
    "openai": "^6.34.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "resend": "^4.0.1",
    "sanitize-html": "^2.17.4",
    "server-only": "^0.0.1",
    "undici": "^6.27.0",
    "web-vitals": "^4.2.4"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22",
    "@types/pg": "^8.11.10",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/sanitize-html": "^2.16.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.11",
    "jsdom": "^29.1.1",
    "pg": "^8.13.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
